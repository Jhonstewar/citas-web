# URL base de la API REST de Spring Boot (citas-api).
# El frontend llama directamente al backend: no hay Express, BFF ni proxy de aplicacion.
# Vite solo expone al bundle las variables con prefijo VITE_. Todo lo que se pone aqui es publico:
# NUNCA colocar secretos JWT, contrasenas de BD ni credenciales de ningun tipo.
VITE_API_URL=http://localhost:8080
